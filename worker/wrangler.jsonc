{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenyu-portfolio-navigator",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://wenyuchiou.github.io",
    "ALLOWED_HOSTNAME": "wenyuchiou.github.io",
    "NVIDIA_MODEL": "stepfun-ai/step-3.7-flash"
  },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }, {
    "name": "EVENT_RATE_LIMITER",
    "namespace_id": "1002",
    "simple": { "limit": 30, "period": 60 }
  }],
  "analytics_engine_datasets": [{
    "binding": "ANALYTICS",
    "dataset": "wenyu_portfolio_events"
  }]
}
